{
  "name": "@tsonic/express",
  "version": "10.0.54",
  "private": false,
  "description": "Native Tsonic implementation of Express",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./index.js": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/runtime/*.test.js dist/tests/tsonic/*.test.js",
    "test:native": "bash ../tsonic/test/scripts/bounded-run.sh host bash -c 'node --import ../tsonic-rust/scripts/register-tsonic-root-loader.mjs --test --test-concurrency=\"$TSONIC_TEST_WORKERS\" tests/native/*/*.test.mjs'",
    "selftest": "bash scripts/selftest.sh",
    "check:branches": "bash scripts/check-branch-hygiene.sh",
    "publish:npm": "bash scripts/selftest.sh && npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsoniclang/express.git"
  },
  "devDependencies": {
    "@tsonic/core": "10.0.46",
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  }
}
